# ---------------------------------------------------------------------------
# StockSense environment
# Copy to `.env` (or `.env.local`) and adjust. Everything has a sane default,
# so the app boots with zero configuration.
# ---------------------------------------------------------------------------

# Where the SQLite file lives. Relative paths are resolved from the repo root.
DATABASE_FILE=data/stocksense.db

# Secret used to sign session cookies. A random one is generated automatically
# on first boot and persisted into .env.local if this is left empty.
SESSION_SECRET=

# OTP behaviour for "forgot password"
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# When true the OTP is echoed back in the API response and printed to the
# server console so the flow is demoable without a mail server.
OTP_DEV_ECHO=true

# Session lifetime
SESSION_TTL_HOURS=72

# Optional SMTP relay for real OTP e-mails. Leave blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=StockSense <no-reply@stocksense.local>
